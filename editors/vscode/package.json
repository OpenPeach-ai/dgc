{
  "name": "dgc",
  "displayName": "Vibe DGC — coding agent for your own models",
  "description": "Run the DGC coding agent against a local, native cloud, or compatible model endpoint inside VS Code and Cursor.",
  "version": "0.33.0",
  "publisher": "vibedgc",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DGC runs a local coding-agent process and is available only in trusted workspaces."
    }
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "coding agent",
    "llm",
    "ollama",
    "local llm",
    "openai compatible",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenPeach-ai/dgc.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/OpenPeach-ai/dgc/issues"
  },
  "homepage": "https://vibedgc.com",
  "galleryBanner": {
    "color": "#0B0B0C",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:dgc.chat",
    "onWebviewPanel:dgc.chatEditor",
    "onWebviewPanel:dgc.chatdgcEditor",
    "onWebviewPanel:dgc.chatdgcWidget"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "dgc.chatdgcCanvasDoc",
        "displayName": "ChatDGC Canvas (formatted)",
        "selector": [
          {
            "filenamePattern": "**/canvas/chat_*/cv_*/*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dgc",
          "title": "DGC",
          "icon": "media/dgc.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "dgcSecondary",
          "title": "DGC",
          "icon": "media/dgc.svg"
        }
      ]
    },
    "views": {
      "dgc": [
        {
          "id": "dgc.chat",
          "type": "webview",
          "name": "DGC",
          "icon": "media/dgc.svg"
        }
      ],
      "dgcSecondary": [
        {
          "id": "dgc.chatSecondary",
          "type": "webview",
          "name": "DGC",
          "icon": "media/dgc.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "dgc.focus",
        "title": "Focus Chat",
        "category": "DGC"
      },
      {
        "command": "dgc.openCommandMenu",
        "title": "Open Command Menu",
        "category": "DGC",
        "icon": "$(terminal)"
      },
      {
        "command": "dgc.newSession",
        "title": "New Session",
        "category": "DGC",
        "icon": "$(add)"
      },
      {
        "command": "dgc.newChatDGC",
        "title": "New Chat (ChatDGC)",
        "category": "DGC",
        "icon": {
          "light": "media/chatdgc-tab-light.svg",
          "dark": "media/chatdgc-tab-dark.svg"
        }
      },
      {
        "command": "dgc.chatdgcCanvasAsk",
        "title": "Ask ChatDGC About This",
        "category": "DGC",
        "icon": {
          "light": "media/chatdgc-tab-light.svg",
          "dark": "media/chatdgc-tab-dark.svg"
        }
      },
      {
        "command": "dgc.chatdgcCanvasShortcut",
        "title": "Canvas Shortcuts…",
        "category": "DGC",
        "icon": "$(sparkle)"
      },
      {
        "command": "dgc.chatdgcCanvasVersions",
        "title": "Canvas Versions…",
        "category": "DGC",
        "icon": "$(history)"
      },
      {
        "command": "dgc.chatdgcCanvasDownload",
        "title": "Download Canvas…",
        "category": "DGC",
        "icon": "$(desktop-download)"
      },
      {
        "command": "dgc.chatdgcCanvasMarkdown",
        "title": "Open Canvas as Markdown",
        "category": "DGC",
        "icon": "$(markdown)"
      },
      {
        "command": "dgc.chatdgcCanvasFormatted",
        "title": "Open Canvas Formatted",
        "category": "DGC",
        "icon": "$(preview)"
      },
      {
        "command": "dgc.newParallelChat",
        "title": "Open a Second Chat",
        "category": "DGC",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "dgc.newChatInFolder",
        "title": "Open a Chat in Another Folder…",
        "category": "DGC",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dgc.switchChat",
        "title": "Switch Chat",
        "category": "DGC"
      },
      {
        "command": "dgc.selectModel",
        "title": "Select Model",
        "category": "DGC"
      },
      {
        "command": "dgc.connect",
        "title": "Connect Provider",
        "category": "DGC"
      },
      {
        "command": "dgc.setMode",
        "title": "Set Permission Mode",
        "category": "DGC"
      },
      {
        "command": "dgc.cycleMode",
        "title": "Cycle Permission Mode",
        "category": "DGC"
      },
      {
        "command": "dgc.setThinking",
        "title": "Set Thinking Level",
        "category": "DGC"
      },
      {
        "command": "dgc.addSelection",
        "title": "Add Selection to DGC",
        "category": "DGC"
      },
      {
        "command": "dgc.addFile",
        "title": "Add File to DGC",
        "category": "DGC"
      },
      {
        "command": "dgc.restart",
        "title": "Restart Backend",
        "category": "DGC"
      },
      {
        "command": "dgc.resume",
        "title": "Resume Session",
        "category": "DGC",
        "icon": "$(history)"
      },
      {
        "command": "dgc.rewind",
        "title": "Rewind (code + conversation)",
        "category": "DGC",
        "icon": "$(discard)"
      },
      {
        "command": "dgc.nameSession",
        "title": "Name Session",
        "category": "DGC"
      },
      {
        "command": "dgc.openSkills",
        "title": "Skills",
        "category": "DGC"
      },
      {
        "command": "dgc.openMcp",
        "title": "MCP Servers",
        "category": "DGC"
      },
      {
        "command": "dgc.openDocs",
        "title": "Documentation",
        "category": "DGC"
      },
      {
        "command": "dgc.openPermissions",
        "title": "Permission Rules",
        "category": "DGC"
      },
      {
        "command": "dgc.openMemory",
        "title": "Memory",
        "category": "DGC"
      },
      {
        "command": "dgc.openHooks",
        "title": "Lifecycle Hooks",
        "category": "DGC"
      },
      {
        "command": "dgc.viewPlan",
        "title": "View Saved Plan",
        "category": "DGC"
      },
      {
        "command": "dgc.artifacts",
        "title": "Artifact Previews",
        "category": "DGC"
      },
      {
        "command": "dgc.goal",
        "title": "Show Goal",
        "category": "DGC"
      },
      {
        "command": "dgc.handoff",
        "title": "Generate Handoff",
        "category": "DGC"
      },
      {
        "command": "dgc.retainedTasks",
        "title": "Retained Sub-agent Tasks",
        "category": "DGC"
      },
      {
        "command": "dgc.compact",
        "title": "Compact Context",
        "category": "DGC"
      },
      {
        "command": "dgc.updateCli",
        "title": "Update CLI to Latest",
        "category": "DGC"
      },
      {
        "command": "dgc.openNotes",
        "title": "Show Context Notes",
        "category": "DGC"
      },
      {
        "command": "dgc.exportTraining",
        "title": "Export Training Data",
        "category": "DGC"
      },
      {
        "command": "dgc.settings",
        "title": "Settings",
        "category": "DGC",
        "icon": "$(settings-gear)"
      },
      {
        "command": "dgc.updateExtension",
        "title": "Check for Extension Updates",
        "category": "DGC"
      },
      {
        "command": "dgc.openPips",
        "title": "Open Pips",
        "category": "DGC",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dgc.openCommandMenu",
          "when": "view == dgc.chat || view == dgc.chatSecondary",
          "group": "navigation@0"
        },
        {
          "command": "dgc.resume",
          "when": "view == dgc.chat || view == dgc.chatSecondary",
          "group": "navigation@1"
        },
        {
          "command": "dgc.newSession",
          "when": "view == dgc.chat || view == dgc.chatSecondary",
          "group": "navigation@2"
        },
        {
          "command": "dgc.settings",
          "when": "view == dgc.chat || view == dgc.chatSecondary",
          "group": "navigation@3"
        },
        {
          "command": "dgc.openPips",
          "when": "view == dgc.chat || view == dgc.chatSecondary",
          "group": "navigation@2.5"
        }
      ],
      "editor/context": [
        {
          "command": "dgc.chatdgcCanvasAsk",
          "when": "dgc.chatdgcCanvas",
          "group": "dgc@0"
        },
        {
          "command": "dgc.addSelection",
          "when": "editorHasSelection",
          "group": "dgc"
        }
      ],
      "editor/title": [
        {
          "command": "dgc.chatdgcCanvasAsk",
          "when": "dgc.chatdgcCanvas",
          "group": "navigation@0"
        },
        {
          "command": "dgc.chatdgcCanvasShortcut",
          "when": "dgc.chatdgcCanvas",
          "group": "navigation@1"
        },
        {
          "command": "dgc.chatdgcCanvasVersions",
          "when": "dgc.chatdgcCanvas",
          "group": "navigation@2"
        },
        {
          "command": "dgc.chatdgcCanvasDownload",
          "when": "dgc.chatdgcCanvas",
          "group": "navigation@3"
        },
        {
          "command": "dgc.chatdgcCanvasMarkdown",
          "when": "dgc.chatdgcCanvasFormatted",
          "group": "navigation@4"
        },
        {
          "command": "dgc.chatdgcCanvasFormatted",
          "when": "dgc.chatdgcCanvas && !dgc.chatdgcCanvasFormatted && resourceExtname == .md",
          "group": "navigation@4"
        }
      ],
      "explorer/context": [
        {
          "command": "dgc.addFile",
          "when": "resourceScheme == file",
          "group": "dgc"
        }
      ],
      "editor/title/context": [
        {
          "command": "dgc.addFile",
          "when": "resourceScheme == file",
          "group": "dgc"
        }
      ],
      "commandPalette": [
        {
          "command": "dgc.chatdgcCanvasAsk",
          "when": "dgc.chatdgcCanvas"
        },
        {
          "command": "dgc.chatdgcCanvasShortcut",
          "when": "dgc.chatdgcCanvas"
        },
        {
          "command": "dgc.chatdgcCanvasVersions",
          "when": "dgc.chatdgcCanvas"
        },
        {
          "command": "dgc.chatdgcCanvasDownload",
          "when": "dgc.chatdgcCanvas"
        },
        {
          "command": "dgc.chatdgcCanvasMarkdown",
          "when": "dgc.chatdgcCanvasFormatted"
        },
        {
          "command": "dgc.chatdgcCanvasFormatted",
          "when": "dgc.chatdgcCanvas && !dgc.chatdgcCanvasFormatted"
        },
        {
          "command": "dgc.selectModel",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.connect",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.setMode",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.cycleMode",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.setThinking",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.resume",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.rewind",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.nameSession",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.openSkills",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.openMcp",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.openPermissions",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.openMemory",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.openHooks",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.viewPlan",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.artifacts",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.goal",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.handoff",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.retainedTasks",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.compact",
          "when": "dgc.ready"
        },
        {
          "command": "dgc.addSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "dgc.addFile",
          "when": "editorIsOpen"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dgc.focus",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "!terminalFocus"
      },
      {
        "command": "dgc.addSelection",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus"
      },
      {
        "command": "dgc.cycleMode",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "!terminalFocus"
      }
    ],
    "configuration": {
      "title": "DGC",
      "properties": {
        "dgc.command": {
          "type": "string",
          "default": "dgc",
          "scope": "machine",
          "description": "Path to the current DGC CLI executable (editor protocol v14 required)."
        },
        "dgc.windows.useWsl": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "On Windows, run DGC inside a small Linux system of its own (a WSL distro DGC sets up and keeps apart from yours). Turn off only to run a DGC you installed on Windows yourself (set dgc.command to it)."
        },
        "dgc.windows.wslDistro": {
          "type": "string",
          "default": "DGC",
          "scope": "machine",
          "description": "The name of DGC's own WSL distro on Windows."
        },
        "dgc.autoUpdateCli": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "description": "When the DGC CLI is older than this extension, update it automatically and reconnect, instead of asking. Skipped when dgc.command names a CLI you chose yourself. The installer refuses to overwrite a git checkout either way."
        },
        "dgc.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "Check the official DGC release on every installation channel, including when an editor marketplace is delayed. Updates are checksum-verified and installed through the editor.",
          "scope": "machine"
        },
        "dgc.baseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Main model host — a supported native or OpenAI-compatible endpoint (e.g. http://localhost:11434/v1). Blank = use the CLI's own config (~/.dgc/config.json). Also editable in the panel's Settings page."
        },
        "dgc.model": {
          "type": "string",
          "default": "",
          "description": "Main model id. Blank = use the CLI's config."
        },
        "dgc.subagentModel": {
          "type": "string",
          "default": "",
          "description": "Model used by `task` sub-agents. Blank = inherit the main model."
        },
        "dgc.subagentBaseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Host for `task` sub-agents — run them on a DIFFERENT machine/model than the main loop. Blank = inherit the main host."
        },
        "dgc.subagentApiMode": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "auto",
            "ollama",
            "anthropic",
            "chat_completions",
            "responses"
          ],
          "description": "Transport for task sub-agents. Blank inherits the main transport on the same host and auto-detects a different host."
        },
        "dgc.fallbackModel": {
          "type": "string",
          "default": "",
          "description": "Model retried automatically if the primary model errors. Blank = no fallback."
        },
        "dgc.fallbackBaseUrl": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Optional host for the fallback model. Blank = same host as the main model."
        },
        "dgc.fallbackApiMode": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "auto",
            "ollama",
            "anthropic",
            "chat_completions",
            "responses"
          ],
          "description": "Transport for the fallback model. Blank inherits the main transport on the same host and auto-detects a different host."
        },
        "dgc.shareBackend": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run the chats in one panel in one `dgc serve`, the way Codex runs its threads — each chat still in its own folder, with its own project, trust, MCP servers and mode. Turn it off to give each chat a process of its own. A session's editor tab always has a process of its own. A backend pinned to one project (`DGC_PROJECT_ROOT`) cannot hold chats in other folders, so those get a process of their own."
        },
        "dgc.maxLiveChats": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "How many chats may hold a live `dgc serve` at once. **0 (the default) means no limit** — open as many as your machine and your model budget allow. Each chat is its own backend with its own model context and session, so the chat you switch away from keeps working. A backend itself is small (about 9 MB); the real cost of another chat is another model context. Set a positive number if you want DGC to stop you at a ceiling, or 1 to keep it single-chat."
        },
        "dgc.closingAWorkingTab": {
          "type": "string",
          "enum": ["ask", "keepRunning", "stop"],
          "enumDescriptions": [
            "Ask each time, and remember the answer if you tick Remember my choice.",
            "Keep it running in the background: a session (Settings › Running sessions shows it, with Stop), or a ChatDGC reply, which is saved when it finishes.",
            "Stop it: the session's turn, or the ChatDGC reply, stops and is saved."
          ],
          "default": "ask",
          "markdownDescription": "What happens when you close a session's tab while it is working, or a ChatDGC chat's tab while it is writing a reply. A window reload or a closed window always keeps the work running, and it comes back when you open it again (up to 12 hours with no window; it saves and stops 2 minutes after its work finishes)."
        },
        "dgc.contextSize": {
          "type": "number",
          "default": 0,
          "description": "Context window (tokens) used for compaction budgeting. 0 = use the CLI's config."
        },
        "dgc.autonomousGate": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "A check command the agent must pass (exit 0) before it may stop a turn; a nonzero exit feeds its output back and continues (e.g. \"npm run check\"). Blank = off."
        },
        "dgc.autonomousMaxTurns": {
          "type": "number",
          "default": 0,
          "description": "Bound on failed autonomous-gate retries before the turn stops. 0 = use the CLI's config (default 30)."
        },
        "dgc.notifyOnTurnEnd": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Show a notification when a DGC turn longer than 20 seconds finishes while the DGC panel is not visible."
        },
        "dgc.notifyPips": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show a notification when a Pip finds something at its alert level or a new review is waiting for you, even when the DGC panel is not on screen. Open Pips goes straight to it."
        },
        "dgc.notifyWhenWaiting": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show a notification when a DGC chat you are not looking at needs your answer: an approval, a question or a plan. Open chat goes straight to it."
        },
        "dgc.linkFavicons": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show each site's own favicon beside a link you type in a prompt. The icon is fetched from Google's favicon service using only the link's origin, never its path or query. Turn this off to use bundled icons and make no network request."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "dgc.gettingStarted",
        "title": "Get Started with DGC",
        "description": "Run a coding agent on your own models, in your editor.",
        "steps": [
          {
            "id": "cli",
            "title": "Install the DGC CLI",
            "description": "DGC drives the current `dgc` CLI (0.48.2 or newer; editor protocol v14 required). Install it with `curl -fsSL https://vibedgc.com/install.sh | bash`, then run `dgc setup`.",
            "media": {
              "markdown": "media/walkthrough.md"
            }
          },
          {
            "id": "open",
            "title": "Open the DGC panel",
            "description": "Click the DGC icon in the activity bar, or press Ctrl/Cmd+Alt+D.",
            "media": {
              "markdown": "media/walkthrough.md"
            },
            "completionEvents": [
              "onView:dgc.chat"
            ]
          },
          {
            "id": "model",
            "title": "Pick your model",
            "description": "Click the model pill or run **DGC: Select Model** to choose from your endpoint.",
            "media": {
              "markdown": "media/walkthrough.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "package": "npm run check-types && node esbuild.js --production",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:host": "node test/run-extension-host.mjs",
    "test:host:stall": "node test/run-extension-host-stall.mjs",
    "test:host:images": "node test/run-extension-host-images.mjs",
    "test:host:reconnect": "node test/run-extension-host-reconnect.mjs",
    "shot": "node test/render-panel.mjs",
    "scroll-check": "node test/render-scroll.mjs"
  },
  "devDependencies": {
    "@novnc/novnc": "1.7.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "4.0.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "highlight.js": "11.12.0",
    "jsdom": "^30.0.1",
    "katex": "0.16.47",
    "markdown-it": "15.0.3",
    "mermaid": "^12.0.0",
    "ovsx": "1.2.0",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.8",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
