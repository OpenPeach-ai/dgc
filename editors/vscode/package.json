{
  "name": "dgc",
  "displayName": "Vibe DGC \u2014 coding agent for your own models",
  "description": "Run the DGC coding agent against a local, native cloud, or compatible model endpoint inside VS Code and Cursor.",
  "version": "0.13.0",
  "publisher": "vibedgc",
  "license": "PolyForm-Noncommercial-1.0.0",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "DGC runs a local coding-agent process and is available only in trusted workspaces."
    }
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "coding agent",
    "llm",
    "ollama",
    "local llm",
    "openai compatible",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenPeach-ai/dgc.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/OpenPeach-ai/dgc/issues"
  },
  "homepage": "https://vibedgc.com",
  "galleryBanner": {
    "color": "#0B0B0C",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:dgc.chat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dgc",
          "title": "DGC",
          "icon": "media/dgc.svg"
        }
      ]
    },
    "views": {
      "dgc": [
        {
          "id": "dgc.chat",
          "type": "webview",
          "name": "DGC",
          "icon": "media/dgc.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "dgc.focus",
        "title": "DGC: Focus Chat",
        "category": "DGC"
      },
      {
        "command": "dgc.openCommandMenu",
        "title": "DGC: Open Command Menu",
        "category": "DGC",
        "icon": "$(terminal)"
      },
      {
        "command": "dgc.newSession",
        "title": "DGC: New Session",
        "category": "DGC",
        "icon": "$(add)"
      },
      {
        "command": "dgc.selectModel",
        "title": "DGC: Select Model",
        "category": "DGC"
      },
      {
        "command": "dgc.connect",
        "title": "DGC: Connect Provider",
        "category": "DGC"
      },
      {
        "command": "dgc.setMode",
        "title": "DGC: Set Permission Mode",
        "category": "DGC"
      },
      {
        "command": "dgc.cycleMode",
        "title": "DGC: Cycle Permission Mode",
        "category": "DGC"
      },
      {
        "command": "dgc.setThinking",
        "title": "DGC: Set Thinking Level",
        "category": "DGC"
      },
      {
        "command": "dgc.addSelection",
        "title": "DGC: Add Selection to DGC",
        "category": "DGC"
      },
      {
        "command": "dgc.restart",
        "title": "DGC: Restart Backend",
        "category": "DGC"
      },
      {
        "command": "dgc.resume",
        "title": "DGC: Resume Session",
        "category": "DGC",
        "icon": "$(history)"
      },
      {
        "command": "dgc.rewind",
        "title": "DGC: Rewind (code + conversation)",
        "category": "DGC",
        "icon": "$(discard)"
      },
      {
        "command": "dgc.nameSession",
        "title": "DGC: Name Session",
        "category": "DGC"
      },
      {
        "command": "dgc.openSkills",
        "title": "DGC: Skills",
        "category": "DGC"
      },
      {
        "command": "dgc.openMcp",
        "title": "DGC: MCP Servers",
        "category": "DGC"
      },
      {
        "command": "dgc.openDocs",
        "title": "DGC: Documentation",
        "category": "DGC"
      },
      {
        "command": "dgc.openPermissions",
        "title": "DGC: Permission Rules",
        "category": "DGC"
      },
      {
        "command": "dgc.openMemory",
        "title": "DGC: Memory",
        "category": "DGC"
      },
      {
        "command": "dgc.openHooks",
        "title": "DGC: Lifecycle Hooks",
        "category": "DGC"
      },
      {
        "command": "dgc.viewPlan",
        "title": "DGC: View Saved Plan",
        "category": "DGC"
      },
      {
        "command": "dgc.artifacts",
        "title": "DGC: Artifact Previews",
        "category": "DGC"
      },
      {
        "command": "dgc.goal",
        "title": "DGC: Show Goal",
        "category": "DGC"
      },
      {
        "command": "dgc.handoff",
        "title": "DGC: Generate Handoff",
        "category": "DGC"
      },
      {
        "command": "dgc.retainedTasks",
        "title": "DGC: Retained Sub-agent Tasks",
        "category": "DGC"
      },
      {
        "command": "dgc.compact",
        "title": "DGC: Compact Context",
        "category": "DGC"
      },
      {
        "command": "dgc.updateCli",
        "title": "DGC: Update CLI to Latest",
        "category": "DGC"
      },
      {
        "command": "dgc.exportTraining",
        "title": "DGC: Export Training Data",
        "category": "DGC"
      },
      {
        "command": "dgc.settings",
        "title": "DGC: Settings",
        "category": "DGC",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dgc.openCommandMenu",
          "when": "view == dgc.chat",
          "group": "navigation@0"
        },
        {
          "command": "dgc.resume",
          "when": "view == dgc.chat",
          "group": "navigation@1"
        },
        {
          "command": "dgc.newSession",
          "when": "view == dgc.chat",
          "group": "navigation@2"
        },
        {
          "command": "dgc.settings",
          "when": "view == dgc.chat",
          "group": "navigation@3"
        }
      ],
      "editor/context": [
        {
          "command": "dgc.addSelection",
          "when": "editorHasSelection",
          "group": "dgc"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dgc.focus",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "dgc.addSelection",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      },
      {
        "command": "dgc.cycleMode",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      }
    ],
    "configuration": {
      "title": "DGC",
      "properties": {
        "dgc.command": {
          "type": "string",
          "default": "dgc",
          "scope": "machine",
          "description": "Path to the DGC CLI executable (v0.26.2+ with editor protocol v5)."
        },
        "dgc.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "description": "For sideloaded (.vsix) installs, check vibedgc.com for a newer extension version and notify. Ignored on Marketplace / Open VSX installs (they auto-update)."
        },
        "dgc.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Main model host \u2014 a supported native or OpenAI-compatible endpoint (e.g. http://localhost:11434/v1). Blank = use the CLI's own config (~/.dgc/config.json). Also editable in the panel's Settings page."
        },
        "dgc.model": {
          "type": "string",
          "default": "",
          "description": "Main model id. Blank = use the CLI's config."
        },
        "dgc.subagentModel": {
          "type": "string",
          "default": "",
          "description": "Model used by `task` sub-agents. Blank = inherit the main model."
        },
        "dgc.subagentBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Host for `task` sub-agents \u2014 run them on a DIFFERENT machine/model than the main loop. Blank = inherit the main host."
        },
        "dgc.subagentApiMode": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "auto",
            "ollama",
            "anthropic",
            "chat_completions",
            "responses"
          ],
          "description": "Transport for task sub-agents. Blank inherits the main transport on the same host and auto-detects a different host."
        },
        "dgc.fallbackModel": {
          "type": "string",
          "default": "",
          "description": "Model retried automatically if the primary model errors. Blank = no fallback."
        },
        "dgc.fallbackBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Optional host for the fallback model. Blank = same host as the main model."
        },
        "dgc.fallbackApiMode": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "auto",
            "ollama",
            "anthropic",
            "chat_completions",
            "responses"
          ],
          "description": "Transport for the fallback model. Blank inherits the main transport on the same host and auto-detects a different host."
        },
        "dgc.contextSize": {
          "type": "number",
          "default": 0,
          "description": "Context window (tokens) used for compaction budgeting. 0 = use the CLI's config."
        },
        "dgc.autonomousGate": {
          "type": "string",
          "default": "",
          "description": "A check command the agent must pass (exit 0) before it may stop a turn; a nonzero exit feeds its output back and continues (e.g. \"npm run check\"). Blank = off."
        },
        "dgc.autonomousMaxTurns": {
          "type": "number",
          "default": 0,
          "description": "Bound on failed autonomous-gate retries before the turn stops. 0 = use the CLI's config (default 30)."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "dgc.gettingStarted",
        "title": "Get Started with DGC",
        "description": "Run a coding agent on your own models, in your editor.",
        "steps": [
          {
            "id": "cli",
            "title": "Install the DGC CLI",
            "description": "DGC drives the `dgc` CLI (v0.26.2+ with editor protocol v5). Install it with `curl -fsSL https://vibedgc.com/install.sh | bash`, then run `dgc setup`.",
            "media": {
              "markdown": "media/walkthrough.md"
            }
          },
          {
            "id": "open",
            "title": "Open the DGC panel",
            "description": "Click the DGC icon in the activity bar, or press Ctrl/Cmd+Escape.",
            "media": {
              "markdown": "media/walkthrough.md"
            },
            "completionEvents": [
              "onView:dgc.chat"
            ]
          },
          {
            "id": "model",
            "title": "Pick your model",
            "description": "Click the model pill or run **DGC: Select Model** to choose from your endpoint.",
            "media": {
              "markdown": "media/walkthrough.md"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit",
    "package": "npm run check-types && node esbuild.js --production",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:host": "node test/run-extension-host.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "ovsx": "1.1.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
